{
  "name": "@data-fair/processing-sensor-community",
  "version": "1.2.0",
  "description": "Import measures of Sensor Community sensors (particulate matter, temperature, humidity) into a data-fair dataset.",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepare": "husky || true",
    "build-types": "export NODE_OPTIONS='--experimental-strip-types' && df-build-types ./config && df-build-types ./types",
    "test-base": "NODE_ENV=test node --experimental-strip-types --test-force-exit --test-concurrency=1 --test --test-reporter=spec --test-reporter-destination=stdout",
    "test": "npm run test-base test-it/*.ts"
  },
  "imports": {
    "#types/*": "./types/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/data-fair/processing-sensor-community.git"
  },
  "keywords": [
    "data-fair-processings-plugin"
  ],
  "author": "Alban Mouton <alban.mouton@gmail.com>",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/data-fair/processing-sensor-community/issues"
  },
  "homepage": "https://github.com/data-fair/processing-sensor-community#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@data-fair/lib-common-types": "^1.24.0",
    "@data-fair/lib-processing-dev": "^0.3.0",
    "@data-fair/lib-types-builder": "^1.14.4",
    "@data-fair/lib-utils": "^1.14.0",
    "axios": "^1.20.0",
    "config": "^5.0.1",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "neostandard": "^0.14.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "processing-config-schema.json",
    "./lib/**/*"
  ]
}
